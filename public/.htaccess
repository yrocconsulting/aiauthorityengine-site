# Force HTTPS and the bare domain
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://aiauthorityengine.org%{REQUEST_URI} [L,R=301]

# Add trailing slash to directory URLs
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# Retired pages
Redirect 301 /videos/ https://aiauthorityengine.org/ai-seo-training/
# Name spelling corrected: Keirstein -> Kierstein (covers the kit page too)
Redirect 301 /certified/jason-keirstein/ https://aiauthorityengine.org/certified/jason-kierstein/
Redirect 301 /certificates/jason-keirstein-d896a7163e68.pdf https://aiauthorityengine.org/certificates/jason-kierstein-d896a7163e68.pdf

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(css|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Always revalidate pages so crawlers and visitors see updates immediately.
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Certificates are private files shared via graduates' kit pages: keep them out of search and AI indexes.
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
</IfModule>

AddType text/plain .txt
AddDefaultCharset UTF-8
